    "wildcraftfruit:*cutting-*": 16,
    "wildcraftfruit:sapling-*": 32,
    "wildcraftfruit:fruittree-*": 16,
    "wildcraftfruit:log-*": 32,
    "wildcraftfruit:leaves-*": 1,
    "wildcraftfruit:vine-*": 2,
    "wildcraftfruit:flower-*": 16,
    "wildcraftfruit:vegetable-*": 16,
    "wildcraftfruit:spice-*": 8
  }
