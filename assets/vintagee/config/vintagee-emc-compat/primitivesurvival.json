  "litreValues": {
    "//lavaportion": "what the Volcanite Amulet charges to place lava",
    "primitivesurvival:lavaportion": 32
  },
  "relativeValues": [
    {
      "code": "primitivesurvival:smokedmeat-*",
      "of": "game:*",
      "ratio": 1.25,
      "//": "the meat it's smoked from, plus a quarter for the smoking"
    },
    {
      "code": "primitivesurvival:curedsmokedmeat-*",
      "of": "game:*",
      "ratio": 1.5,
      "//": "the meat it's made from, plus half for curing and smoking"
    },
    {
      "code": "primitivesurvival:furrowedland-*-free",
      "of": "game:soil-*-none",
      "ratio": 1,
      "//": "ploughed soil is still that soil"
    },
    {
      "code": "primitivesurvival:metalfishinghook-*",
      "of": "game:ingot-*",
      "ratio": 0.25,
      "//": "cast from a quarter ingot of the metal"
    },
    {
      "code": "primitivesurvival:fishinglure-*",
      "of": "game:ingot-*",
      "ratio": 0.5,
      "//": "cast from half an ingot of the metal"
    },
    {
      "code": "primitivesurvival:spikeplate-*",
      "of": "game:ingot-*",
      "ratio": 2,
      "//": "cast from two ingots of the metal"
    },
    {
      "code": "primitivesurvival:treehollowplaced-*",
      "of": "game:log-placed-*-ud",
      "ratio": 1,
      "//": "a hollow log is still a log"
    },
    {
      "code": "primitivesurvival:stakeinwater-*",
      "of": "primitivesurvival:stake",
      "ratio": 1,
      "//": "the stake, placed in water"
    },
    {
      "code": "primitivesurvival:fishbasketinwater-*",
      "of": "primitivesurvival:fishbasket-*",
      "ratio": 1,
      "//": "the basket, placed in water"
    }
  ],
  "blacklist": [
    "primitivesurvival:livingdead-*",
    "primitivesurvival:texture*",
    "primitivesurvival:foilage",
    "primitivesurvival:fireflies",
    "primitivesurvival:bfuse-*",
    "primitivesurvival:raft*-*",
    "primitivesurvival:treehollowgrown-*",
    "primitivesurvival:weirtrap-*",
    "primitivesurvival:limbtrotlinelure-*"
  ]
}
