{
  "name": "Primitive Survival",
  "requiresMod": "primitivesurvival",
  "//": "Fish, crabs, snakes, worms, trophies and relics that no recipe makes. Every value is pegged to an entry in vintagee-emc.json (the base game's raw materials): a raw fish 24, bush meat 16, an egg 16, an insect 4, glow worms 8, hides 16/32/48/80 by size, a bone 24, a temporal gear 4096. Only used when nothing else values the item; the '//' lines say why each number was chosen.",
  "defaultValues": {
    "//psfish-*": "the game's raw fish is 24; these cook to 240 satiety like it",
    "primitivesurvival:psfish-*": 24,
    "//psfish-bass-*": "cooks to 120 satiety, half a normal fish",
    "primitivesurvival:psfish-bass-*": 12,
    "//psfish-bluegill-*": "cooks to 120 satiety, half a normal fish",
