    "primitivesurvival:earthworm": 4,
    "//earthwormcastings": "a fertiliser block, like compost (8)",
    "primitivesurvival:earthwormcastings": 8,
    "//bioluminescent-*": "like glow worms (8)",
    "primitivesurvival:bioluminescent-*": 8,
    "//willowisp-*": "a rare catch, like a flower or a mushroom x2",
