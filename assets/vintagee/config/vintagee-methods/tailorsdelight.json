{
  "//": "PROBE (temporary): where the game puts Tailor's Delight's compatibility/butchering recipe files.",
  "format": 1,
  "requiresMod": [ "tailorsdelight", "butchering" ],
  "methods": [
    {
      "code": "tailorsdelight:locationprobe",
      "name": "probe",
      "readers": [
        { "from": "assets", "folder": "compatibility/butchering/recipes/grid", "domain": "tailorsdelight",
          "recipe": { "inputs": [], "outputs": [ { "code": "$output.code" } ] } },
        { "from": "assets", "folder": "recipes/grid/td", "domain": "tailorsdelight",
          "recipe": { "inputs": [], "outputs": [ { "code": "$output.code" } ] } },
        { "from": "assets", "folder": "recipes/grid/td", "domain": "butchering",
          "recipe": { "inputs": [], "outputs": [ { "code": "$output.code" } ] } },
        { "from": "assets", "folder": "compatibility/butchering", "domain": "tailorsdelight",
          "recipe": { "inputs": [], "outputs": [ { "code": "$output.code" } ] } }
      ]
    }
  ]
}
